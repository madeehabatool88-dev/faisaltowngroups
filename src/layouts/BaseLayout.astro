---
import "../styles/global.css";
import "../styles/refinements.css";
import { site } from "../data/site";

const {
  title = "Faisal Town Islamabad - Plots, Blocks, Map & Availability",
  description = "FaisalTown Groups provides Faisal Town Islamabad guidance with separate Phase 1/F-18 and Phase 2/FT-II project pages, maps, plots and buyer support.",
  image = site.defaultImage,
  ogType = "website",
  additionalSchema = [],
  bodyClass = "",
  noindex = false,
} = Astro.props;

// Site-owned public GTM ID. PUBLIC_GTM_ID may override it at build time.
const configuredGtmId = import.meta.env.PUBLIC_GTM_ID || "GTM-MRJB3WSF";
const gtmEnabled = import.meta.env.PUBLIC_GTM_ENABLED !== "false";
const gtmId = gtmEnabled && /^GTM-[A-Z0-9]+$/.test(configuredGtmId) ? configuredGtmId : "";

const canonical = new URL(Astro.url.pathname, site.domain).toString();
const socialImage = new URL(image, site.domain).toString();
const baseGraph = [
  {
    "@type": "WebSite",
    "@id": `${site.domain}#website`,
    url: site.domain,
    name: site.name,
    description:
      "Independent property information, map guidance and buyer assistance for selected Faisal Town projects in Pakistan.",
    inLanguage: "en",
  },
  {
    "@type": "Organization",
    "@id": `${site.domain}#organization`,
    name: site.name,
    url: site.domain,
    description: site.disclosure,
    contactPoint: {
      "@type": "ContactPoint",
      url: `https://wa.me/${site.phoneWhatsApp}`,
      contactType: "property information and buyer assistance via WhatsApp",
      areaServed: "PK",
      availableLanguage: ["en", "ur"],
    },
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#641323" />
    <meta name="color-scheme" content="light" />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
    <slot name="head" />
    {gtmId && (
      <script is:inline set:html={`(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer',${JSON.stringify(gtmId)});`}/>
    )}
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@graph": [...baseGraph, ...additionalSchema],
      })}
    ></script>
  </head>
  <body class={bodyClass}>
    {gtmId && (
      <noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`} height="0" width="0" style="display:none;visibility:hidden" title="Google Tag Manager"></iframe></noscript>
    )}
    <slot />
    <script>
      import "../scripts/enquiries";
    </script>
  </body>
</html>
