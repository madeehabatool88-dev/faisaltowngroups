---
import ContentLayout from "../../layouts/ContentLayout.astro";
import { articles } from "../../data/articles";

const moneyLinks = [
  ["Faisal Town Phase 1", "/faisal-town-phase-1/"],
  ["Faisal Town Phase 2", "/faisal-town-phase-2/"],
  ["Plots for Sale", "/plots-for-sale-faisal-town-islamabad/"],
  ["Master Plan & Location", "/faisal-town-islamabad-map-location/"],
  ["Sector P Prices", "/#prices"],
  ["All Pages", "/all-pages/"]
];

const clusterOrder = [
  "Faisal Town Phase 2",
  "Prices & Payment Plans",
  "Location & Maps",
  "Investment & Buyer Guides",
  "Comparisons"
];

const groupedArticles = clusterOrder
  .map((cluster) => ({
    cluster,
    items: articles.filter((article) => article.cluster === cluster)
  }))
  .filter((group) => group.items.length > 0);

const ungroupedArticles = articles.filter((article) => !article.cluster);
---

<ContentLayout
  title="Faisal Town Articles and Buyer Guides"
  description="Read Faisal Town buyer resources grouped by Phase 2, prices, maps, comparisons, living guides and property verification topics."
  eyebrow="Buyer Resources"
  heading="Faisal Town buyer resources."
  subheading="Helpful guides for buyers comparing Faisal Town Phase 1/F-18, Faisal Town Phase 2/FT-II, Sector P, Faisal Hills, maps, prices and location checks."
>
  <section class="content-section archive-shortcuts">
    <div class="section-intro">
      <p class="section-label">Project Details</p>
      <h2>Looking for current project pages instead?</h2>
      <p>Use these direct pages for prices, maps, sectors and availability. The articles below support those pages with buyer education and long-tail guidance.</p>
    </div>
    <div class="article-shortcut-grid">
      {moneyLinks.map(([label, href]) => <a href={href}>{label}</a>)}
    </div>
  </section>

  <section class="content-section">
    {groupedArticles.map((group) => (
      <div class="article-cluster">
        <div class="section-intro compact-intro">
          <p class="section-label">Faisal Town Guides</p>
          <h2>{group.cluster}</h2>
        </div>
        <div class="article-grid">
          {group.items.map((article) => (
            <article class="article-card">
              <a href={`/articles/${article.slug}/`} aria-label={article.title}>
                <img src={article.image} alt={article.title} loading="lazy" />
              </a>
              <div>
                <span>{article.category} - {article.readTime}</span>
                <h3><a href={`/articles/${article.slug}/`}>{article.title}</a></h3>
                <p>{article.description}</p>
                <a class="text-link" href={`/articles/${article.slug}/`}>Read Article</a>
              </div>
            </article>
          ))}
        </div>
      </div>
    ))}
    {ungroupedArticles.length > 0 && (
      <div class="article-cluster">
        <div class="section-intro compact-intro">
          <p class="section-label">More Guides</p>
          <h2>Additional buyer resources</h2>
        </div>
        <div class="article-grid">
          {ungroupedArticles.map((article) => (
            <article class="article-card">
              <a href={`/articles/${article.slug}/`} aria-label={article.title}>
                <img src={article.image} alt={article.title} loading="lazy" />
              </a>
              <div>
                <span>{article.category} - {article.readTime}</span>
                <h3><a href={`/articles/${article.slug}/`}>{article.title}</a></h3>
                <p>{article.description}</p>
                <a class="text-link" href={`/articles/${article.slug}/`}>Read Article</a>
              </div>
            </article>
          ))}
        </div>
      </div>
    )}
  </section>
</ContentLayout>
