---
import ResponsiveImage from "../../components/ResponsiveImage.astro";
import ContentLayout from "../../layouts/ContentLayout.astro";
import { articles } from "../../data/articles";
---
<ContentLayout
  title="Faisal Town Phase 2 Master Plan Guide"
  description="Explore the Faisal Town Phase 2 master plan guide for sector layout, roads and plot-location checks."
  eyebrow="Master Plan"
  heading="Faisal Town Phase 2 map guide"
  subheading="Explore the Phase 2 layout, connecting roads and sector plans before shortlisting a plot."
>
  <section class="content-section">
    <h2>Choose the right reference</h2>
    <p>Use the master plan to locate a sector, a dedicated sector plan to locate a plot, and the location guide to compare Phase 1 and Phase 2. Maps show planned layouts; confirm current stock and site conditions separately.</p>
    <ul>
      <li><a href="/faisal-town-islamabad-map-location/">Phase 1 and Phase 2 location guide</a></li>
      <li><a href="/faisal-town-phase-2/">Phase 2 sectors and full-payment price references</a></li>
      <li><a href="/all-pages/">All sector guides and downloadable plans</a></li>
    </ul>
    <div class="article-grid compact">
      {articles.map((article) => (
        <article class="article-card">
          <ResponsiveImage src={article.image} alt={article.title} loading="lazy" />
          <div>
            <span>{article.category} · {article.readTime}</span>
            <h2><a href={`/articles/${article.slug}/`}>{article.title}</a></h2>
            <p>{article.description}</p>
            <a class="text-link" href={`/articles/${article.slug}/`}>Open Master Plan Guide</a>
          </div>
        </article>
      ))}
    </div>
  </section>
</ContentLayout>
