---
import presentation from '../content/homepage/presentation.json';
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Header from "../components/home/Header.astro";
import Hero from "../components/home/Hero.astro";
import AboutPhase2 from "../components/home/AboutPhase2.astro";
import Trust from "../components/home/Trust.astro";
import FeaturedOffer from "../components/home/FeaturedOffer.astro";
import Prices from "../components/home/Prices.astro";
import Budgets from "../components/home/Budgets.astro";
import Sectors from "../components/home/Sectors.astro";
import Development from "../components/home/Development.astro";
import MasterPlan from "../components/home/MasterPlan.astro";
import BuyerSupport from "../components/home/BuyerSupport.astro";
import BuyingProcess from "../components/home/BuyingProcess.astro";
import VisitOverseas from "../components/home/VisitOverseas.astro";
import Faqs from "../components/home/Faqs.astro";
import BuyerGuides from "../components/home/BuyerGuides.astro";
import Phase1 from "../components/home/Phase1.astro";
import FinalCta from "../components/home/FinalCta.astro";
import StickyBar from "../components/home/StickyBar.astro";
import { hero, phase2, phase1, contact } from "../data/homepage";
import {
  controls as c,
  trust,
  budgets,
  support,
  process,
  assistance,
  faqs,
  guides,
  enabled,
  budgetRows,
  supportRows,
  processRows,
  faqRows,
} from "../data/homepageView";
import { bulkRows } from "../data/homepageBulk";
import { articles } from "../data/articles";
import { site } from "../data/site";
import "../styles/homepage.css";

const labels = Object.fromEntries(bulkRows(presentation.labelsText, ['key', 'value'], 'Homepage labels').map(row => [row.key, row.value]));
const navigation = bulkRows(presentation.navigationText, ['label', 'href'], 'Homepage navigation');
const benefits = bulkRows(presentation.benefitsText, ['title', 'text', 'icon'], 'Homepage benefits');
const offers = phase2.priceTable.rows.filter(enabled);

const offer = phase2.sectorP;

/*
 * Homepage starting price now comes from the CMS Featured Offer.
 * This allows Sector T to be the homepage entry-price offer while
 * the separate Sector P price table stays untouched.
 */
const featuredPriceFact = offer.facts?.find((fact) =>
  /discounted(?:\s+listed)?\s+price/i.test(fact.label),
);

const featuredStarting = featuredPriceFact?.value || "";

/*
 * Detect featured sector from the CMS heading.
 * Examples:
 * "Sector T 5.56 Marla from PKR 27.90 Lac" -> "Sector T"
 * "Sector P / The Caladan..." -> "Sector P"
 */
const featuredSector =
  offer.heading?.match(/^Sector\s+[A-Z0-9]+/i)?.[0] || "Sector T";

/*
 * Only show a featured-sector plan when the saved plan actually belongs
 * to the currently featured sector. This prevents the old Sector P plan
 * appearing inside a Sector T featured offer.
 */
const showFeaturedPlan =
  Boolean(offer.sectorPlan?.pdf) &&
  Boolean(
    offer.sectorPlan?.heading
      ?.toLowerCase()
      .includes(featuredSector.toLowerCase()),
  );

const sectors = phase2.sectors
  .filter(enabled)
  .sort(
    (a, b) =>
      Number(b.href === offer.primaryHref) -
      Number(a.href === offer.primaryHref),
  );

const selectedGuides = phase2.articleSlugs
  .map((slug) => articles.find((a) => a.slug === slug))
  .filter((article): article is (typeof articles)[number] => Boolean(article))
  .slice(0, Math.max(0, guides.displayLimit));

const phase1Articles = phase1.articleSlugs
  .map((slug) => articles.find((a) => a.slug === slug))
  .filter((article): article is (typeof articles)[number] => Boolean(article));

const heroSecondaryHref =
  !c.sectors && hero.secondaryHref === "#phase-2-sectors"
    ? "/faisal-town-phase-2/"
    : hero.secondaryHref;

const schema =
  c.faqs && faqRows.length
    ? [
        {
          "@type": "FAQPage",
          mainEntity: faqRows.map((row) => ({
            "@type": "Question",
            name: row.question,
            acceptedAnswer: {
              "@type": "Answer",
              text: row.answer,
            },
          })),
        },
      ]
    : [];

const sticky = site.stickyCallEnabled || site.stickyWhatsAppEnabled;
---

<BaseLayout
  title={hero.seoTitle}
  description={hero.metaDescription}
  image={hero.heroImage}
  additionalSchema={schema}
  bodyClass={`hp-page ${sticky ? "hp-has-bar" : ""}`}
>
  <a class="hp-skip" href="#top">
    Skip to content
  </a>

  <Header
    navigation={navigation}
    labels={labels}
    whatsappQuery={hero.primaryWhatsappQuery}
  />

  <main id="top">
    {c.hero && (
      <Hero
        hero={hero}
        featuredStarting={featuredStarting}
        featuredSector={featuredSector}
        secondaryHref={heroSecondaryHref}
      />
    )}

    {c.aboutPhase2 && (
      <AboutPhase2 phase2={phase2} benefits={benefits} />
    )}

    {c.trust && (
      <Trust trust={trust} />
    )}

    {c.featuredOffer && (
      <FeaturedOffer
        offer={offer}
        featuredSector={featuredSector}
        featuredStarting={featuredStarting}
        showFeaturedPlan={showFeaturedPlan}
      />
    )}

    {c.prices && (
      <Prices
        table={phase2.priceTable}
        offers={offers}
        labels={labels}
      />
    )}

    {c.budgets && (
      <Budgets budgets={budgets} rows={budgetRows} />
    )}

    {c.sectors && (
      <Sectors
        sectors={sectors}
        heading={phase2.sectorsHeading}
        labels={labels}
        featuredHref={offer.primaryHref}
      />
    )}

    {c.development && (
      <Development development={phase2.development} />
    )}

    {c.masterPlan && (
      <MasterPlan masterPlan={phase2.masterPlan} />
    )}

    {c.buyerSupport && (
      <BuyerSupport support={support} rows={supportRows} />
    )}

    {c.buyingProcess && (
      <BuyingProcess process={process} rows={processRows} />
    )}

    {c.visitOverseas && (
      <VisitOverseas assistance={assistance} labels={labels} />
    )}

    {c.faqs && faqRows.length > 0 && (
      <Faqs faqs={faqs} rows={faqRows} eyebrow={labels.faqEyebrow} />
    )}

    {c.buyerGuides && (
      <BuyerGuides
        guides={guides}
        articles={selectedGuides}
        linkLabel={labels.guideLink}
      />
    )}

    {c.phase1 && (
      <Phase1 phase1={phase1} articles={phase1Articles} />
    )}

    {c.finalCta && (
      <FinalCta contact={contact} />
    )}
  </main>

  <SiteFooter />

  {sticky && (
    <StickyBar labels={labels} whatsappQuery={hero.primaryWhatsappQuery} />
  )}
</BaseLayout>
