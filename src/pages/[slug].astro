---
import { bulkRows } from "../data/homepageBulk";
import ContentLayout from "../layouts/ContentLayout.astro";
import { landingPages } from "../data/landingPages";
import { whatsappLink, site } from "../data/site";
import { imageMeta } from "../data/imageMeta";

export function getStaticPaths() {
  return landingPages.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

const { page } = Astro.props;
const isInstallmentPlan = Boolean(page.installmentRowsText?.trim());
const rateRows = bulkRows((isInstallmentPlan ? page.installmentRowsText : page.rateDetailsText) || "", ["size", "dimensions", "cost", "registration", "actual", "discount"], "Sector rate list");
const slugify = (value: string) => value.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");
const pageUrl = new URL(`/${page.slug}/`, site.domain).toString();
const img = imageMeta[page.image];
const formatDate = (value: string) => new Date(`${value.slice(0,10)}T00:00:00Z`).toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" });

const additionalSchema = [
  {
    "@type": "WebPage",
    "@id": `${pageUrl}#webpage`,
    url: pageUrl,
    name: page.title,
    description: page.description,
    isPartOf: { "@id": `${site.domain}#website` },
    publisher: { "@id": `${site.domain}#organization` },
    primaryImageOfPage: { "@type": "ImageObject", url: new URL(page.image, site.domain).toString() },
    dateModified: page.updated,
    inLanguage: "en"
  },
  {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: site.domain },
      { "@type": "ListItem", position: 2, name: page.h1, item: pageUrl }
    ]
  },
  ...(page.faqs?.length ? [{
    "@type": "FAQPage",
    mainEntity: page.faqs.map((faq) => ({
      "@type": "Question",
      name: faq.question,
      acceptedAnswer: { "@type": "Answer", text: faq.answer }
    }))
  }] : [])
];
---

<ContentLayout
  title={page.title}
  description={page.description}
  eyebrow={page.eyebrow}
  heading={page.h1}
  subheading={page.intro}
  image={page.image}
  heroBackgroundImage={page.heroBackgroundImage}
  additionalSchema={additionalSchema}
  compactHero={true}
  primaryLabel={page.primaryCta}
  primaryMessage={`${page.primaryCta}: ${page.h1}`}
  secondaryLabel={page.secondaryCta}
>
  <article class="content-section landing-page clean-landing">
    <section class="clean-summary" aria-labelledby="quick-answer-heading">
      <div>
        <p class="section-label">{page.quickAnswerLabel ?? "Quick Answer"}</p>
        <h2 id="quick-answer-heading">{page.quickAnswerHeading ?? "Property Options at a Glance"}</h2>
        <p>{page.quickAnswer ?? page.intro}</p>
      </div>
      <a class="btn primary" data-cta-location="quick-answer" href={whatsappLink(`${page.primaryCta}: ${page.h1}`)}>{page.primaryCta}</a>
    </section>

    <nav class="clean-toc" aria-label="On this page">
      <strong>On this page</strong>
      <div>
        {(rateRows.length > 0 || page.priceTableRows?.length > 0) && <a href="#rate-list">Rate list</a>}
        {page.sections.map((section) => <a href={`#${slugify(section.heading)}`}>{section.heading}</a>)}
        {page.downloads && page.downloads.length > 0 && <a href="#plans-downloads">Plans & downloads</a>}
        {page.bullets.length > 0 && <a href="#buyer-checklist">{page.checklistLabel}</a>}
        {page.faqs.length > 0 && <a href="#faqs">{page.faqLabel}</a>}
      </div>
    </nav>

    {page.showMainImage !== false && page.image && <figure class="clean-hero-figure clean-plan-figure">
      <img
        class="article-hero-image landing-image clean-plan-image"
        src={page.image}
        alt={page.imageAlt || page.h1}
        width={img?.width}
        height={img?.height}
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
      {page.imageCaption && <figcaption>{page.imageCaption}</figcaption>}
    </figure>}

    {page.priceTableRows && page.priceTableRows.length > 0 && (
      <section class="clean-price-section" id="rate-list" aria-labelledby="price-table-heading">
        <div class="clean-price-heading">
          <p class="section-label">Current Prices</p>
          <h2 id="price-table-heading">{page.priceTableHeading || `${page.h1} Prices`}</h2>
        </div>

        {page.rateSheetImage && <figure class="sector-rate-sheet">
          <a href={page.rateSheetImage} aria-label="Open full rate sheet"><img src={page.rateSheetImage} alt={page.rateSheetAlt || "Sector reference rate sheet"} width={imageMeta[page.rateSheetImage]?.width || 1280} height={imageMeta[page.rateSheetImage]?.height || 904} loading="lazy" decoding="async" /></a>
          <figcaption>Supplied reference rate sheet · Tap to open at full size. Confirm current rates and available plot numbers.</figcaption>
        </figure>}
        {rateRows.length > 0 ? <>
          <p class="clean-price-note">All amounts in PKR. Confirm current plot availability and any additional location charges.</p>
          <div class="clean-table-wrap" tabindex="0" role="region" aria-label="Full sector rate list">
            <table class="clean-price-table sector-full-rates">
              <caption>{isInstallmentPlan ? "Down payment + 36 monthly payments = installment total. Lump-sum prices are separate." : "Plot cost, registration fee, actual price and discounted listed price"}</caption>
              <thead><tr>{(isInstallmentPlan ? ["Plot Size", "Dimensions", "Installment Total", "Down Payment", "Monthly Payment × 36", "Lump-Sum Price"] : ["Plot Size", "Dimensions", "Cost of Plot", "Registration Fee", "Actual Price", "Discounted Price"]).map(label => <th scope="col">{label}</th>)}</tr></thead>
              <tbody>{rateRows.map(row => <tr>
                <th scope="row">{row.size}</th><td>{row.dimensions}</td><td>{row.cost}</td><td>{row.registration}</td><td>{row.actual}</td><td><strong>{row.discount}</strong></td>
              </tr>)}</tbody>
            </table>
          </div>
          <p class="rate-scroll-hint">On a small screen, swipe the table to see the full breakdown.</p>
        </> : (
        <div class="clean-table-wrap">
          <table class="clean-price-table">
            <thead>
              <tr>
                <th scope="col">Plot Size</th>
                <th scope="col">Dimensions</th>
                <th scope="col">Payment</th>
                <th scope="col">Current Price</th>
                <th scope="col">Availability</th>
              </tr>
            </thead>
            <tbody>
              {page.priceTableRows.map((row) => (
                <tr>
                  <td data-label="Plot Size">{row.size}</td>
                  <td data-label="Dimensions">{row.dimensions}</td>
                  <td data-label="Payment">{row.payment}</td>
                  <td data-label="Current Price">{row.price}</td>
                  <td data-label="Availability">{row.availability}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        )}
        {page.rateConditions && <p class="clean-price-note">{page.rateConditions}</p>}
        {page.rateInquiryLabel && page.rateInquiryQuery && <a class="btn primary rate-inquiry" data-cta-location="rate-list" href={whatsappLink(page.rateInquiryQuery)}>{page.rateInquiryLabel}</a>}

        {page.priceTableNote && <p class="clean-price-note">{page.priceTableNote}</p>}
      </section>
    )}

    {page.highlights?.length > 0 && (
      <div class="clean-highlights">
        {page.highlights.map((highlight) => (
          <article>
            <span>{highlight.label}</span>
            <strong>{highlight.value}</strong>
          </article>
        ))}
      </div>
    )}

    <aside class="clean-verification-note">
      <strong>{page.verificationLabel}</strong>
      <span>{page.verificationText}</span>
      <div class="page-dates">{page.updated && <time datetime={page.updated}>Updated {formatDate(page.updated)}</time>}{page.reviewed && <time datetime={page.reviewed}>Reviewed {formatDate(page.reviewed)}</time>}</div>
    </aside>

    <div class="clean-sections">
      {page.sections.map((section, index) => (
        <section class="clean-copy" id={slugify(section.heading)}>
          <div class="clean-section-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</div>
          <div>
            <h2>{section.heading}</h2>
            {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            {page.sectionLinks?.filter(link => link.heading === section.heading).map(link => <a class="btn outline" href={link.href}>{link.label}</a>)}
          </div>
        </section>
      ))}
    </div>

    {page.downloads && page.downloads.length > 0 && (
      <section class="clean-panel" id="plans-downloads">
        <div class="clean-panel-heading">
          <p class="section-label">{page.downloadsLabel}</p>
          <h2>{page.downloadsHeading}</h2>
        </div>
        <div class="download-card-grid">
          {page.downloads.map((download) => (
            <article class="download-card">
              <span>{download.label}</span>
              <h3>{download.title}</h3>
              <p>{download.text}</p>
              <a href={download.href} target="_blank" rel="noreferrer">{page.downloadButtonLabel}</a>
            </article>
          ))}
        </div>
      </section>
    )}

    {page.planCalloutHref && <aside class="clean-panel"><p class="section-label">{page.planCalloutLabel}</p><h2>{page.planCalloutHeading}</h2><a class="btn outline" href={page.planCalloutHref}>{page.planCalloutButton}</a></aside>}

    {page.bullets.length > 0 && <section class="clean-panel" id="buyer-checklist">
      <div class="clean-panel-heading">
        <p class="section-label">{page.checklistLabel}</p>
        <h2>{page.checklistHeading}</h2>
      </div>
      <div class="clean-checklist">
        {page.bullets.map((item, index) => (
          <article>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </section>}

    <section class="clean-contact-card" aria-labelledby="clean-contact-heading">
      <div>
        <p class="section-label">{page.ctaEyebrow ?? "Current Availability"}</p>
        <h2 id="clean-contact-heading">{page.ctaHeading ?? "Check Available Properties on WhatsApp"}</h2>
        <p>{page.ctaText ?? "Ask for the latest current options and confirm the exact property details before proceeding."}</p>
      </div>
      <div class="clean-contact-actions">
        <a class="btn primary" data-cta-location="landing-bottom" href={whatsappLink(`${page.primaryCta}: ${page.h1}`)}>{page.primaryCta}</a>
        <a class="btn outline" data-cta-location="landing-bottom-secondary" href={whatsappLink(`${page.secondaryCta}: ${page.h1}`)}>{page.secondaryCta}</a>
      </div>
    </section>

    {page.faqs?.length > 0 && (
      <section class="clean-faq" id="faqs">
        <p class="section-label">{page.faqLabel}</p>
        <h2>{page.faqHeading}</h2>
        <div class="faq-list">
          {page.faqs.map((faq) => (
            <details>
              <summary>{faq.question}</summary>
              <p>{faq.answer}</p>
            </details>
          ))}
        </div>
      </section>
    )}

    {page.links.length > 0 && <section class="clean-related">
      <p class="section-label">{page.relatedLabel}</p>
      <h2>{page.relatedHeading}</h2>
      <div class="related-links">
        {page.links.map((link) => <a href={link.href}>{link.label}</a>)}

      </div>
    </section>}
  </article>
</ContentLayout>

<style>
.page-dates { display: flex; flex-direction: column; gap: 6px; flex-shrink: 0; }
.page-dates time { white-space: normal; }
</style>

<style>
.sector-rate-sheet { margin: 20px 0; }
.sector-rate-sheet img { display: block; width: 100%; height: auto; aspect-ratio: auto; object-fit: contain; }
.sector-rate-sheet figcaption, .rate-scroll-hint { font-size: 13px; line-height: 1.6; margin: 12px 0; }
.rate-inquiry { margin-top: 20px; }
#rate-list { scroll-margin-top: 100px; }
.sector-full-rates caption { text-align: left; padding: 12px; font-size: 14px; }
.sector-full-rates td:last-child { color: #641323; }
@media(max-width: 768px) {
  .clean-table-wrap:has(.sector-full-rates) { overflow-x: auto; border: 1px solid #ded6cc; }
  .clean-price-table.sector-full-rates { display: table; min-width: 850px; }
  .sector-full-rates thead { display: table-header-group; position: static; width: auto; height: auto; clip: auto; }
  .sector-full-rates tbody { display: table-row-group; }
  .sector-full-rates tr { display: table-row; }
  .sector-full-rates td, .sector-full-rates th { display: table-cell; padding: 14px; font-size: 14px; }
  .sector-full-rates td::before { display: none; }
  .rate-inquiry { width: 100%; text-align: center; }
}
</style>
