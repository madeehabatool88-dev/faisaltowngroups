---
import ContentLayout from "../layouts/ContentLayout.astro";
import { landingPages } from "../data/landingPages";
import { whatsappLink, site } from "../data/site";
import { imageMeta } from "../data/imageMeta";

export function getStaticPaths() {
  return landingPages.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

const { page } = Astro.props;
const slugify = (value: string) => value.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");
const pageUrl = new URL(`/${page.slug}/`, site.domain).toString();
const img = imageMeta[page.image];

const additionalSchema = [
  {
    "@type": "WebPage",
    "@id": `${pageUrl}#webpage`,
    url: pageUrl,
    name: page.title,
    description: page.description,
    isPartOf: { "@id": `${site.domain}#website` },
    publisher: { "@id": `${site.domain}#organization` },
    primaryImageOfPage: { "@type": "ImageObject", url: new URL(page.image, site.domain).toString() },
    dateModified: page.updated,
    inLanguage: "en"
  },
  {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: site.domain },
      { "@type": "ListItem", position: 2, name: page.h1, item: pageUrl }
    ]
  },
  ...(page.faqs?.length ? [{
    "@type": "FAQPage",
    mainEntity: page.faqs.map((faq) => ({
      "@type": "Question",
      name: faq.question,
      acceptedAnswer: { "@type": "Answer", text: faq.answer }
    }))
  }] : [])
];
---

<ContentLayout
  title={page.title}
  description={page.description}
  eyebrow={page.eyebrow}
  heading={page.h1}
  subheading={page.intro}
  image={page.image}
  additionalSchema={additionalSchema}
  compactHero={true}
>
  <article class="content-section landing-page clean-landing">
    <section class="clean-summary" aria-labelledby="quick-answer-heading">
      <div>
        <p class="section-label">Quick Answer</p>
        <h2 id="quick-answer-heading">What matters on this page</h2>
        <p>{page.intro}</p>
      </div>
      <a class="btn primary" data-cta-location="quick-answer" href={whatsappLink(`Send current options for: ${page.h1}`)}>Check Current Options</a>
    </section>

    <nav class="clean-toc" aria-label="On this page">
      <strong>On this page</strong>
      <div>
        {page.sections.map((section) => <a href={`#${slugify(section.heading)}`}>{section.heading}</a>)}
        {page.downloads && page.downloads.length > 0 && <a href="#plans-downloads">Plans & downloads</a>}
        <a href="#buyer-checklist">Buyer checklist</a>
        <a href="#faqs">FAQs</a>
      </div>
    </nav>

    <figure class="clean-hero-figure clean-plan-figure">
      <img
        class="article-hero-image landing-image clean-plan-image"
        src={page.image}
        alt={`${page.h1} plan`}
        width={img?.width}
        height={img?.height}
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
      <figcaption>Use the plan as a layout reference. Ask for the exact currently available plot to be marked before you shortlist.</figcaption>
    </figure>

    {page.priceTableRows && page.priceTableRows.length > 0 && (
      <section class="clean-price-section" aria-labelledby="price-table-heading">
        <div class="clean-price-heading">
          <p class="section-label">Current Prices</p>
          <h2 id="price-table-heading">{page.priceTableHeading || `${page.h1} Prices`}</h2>
        </div>

        <div class="clean-table-wrap">
          <table class="clean-price-table">
            <thead>
              <tr>
                <th scope="col">Plot Size</th>
                <th scope="col">Dimensions</th>
                <th scope="col">Payment</th>
                <th scope="col">Current Price</th>
                <th scope="col">Availability</th>
              </tr>
            </thead>
            <tbody>
              {page.priceTableRows.map((row) => (
                <tr>
                  <td data-label="Plot Size">{row.size}</td>
                  <td data-label="Dimensions">{row.dimensions}</td>
                  <td data-label="Payment">{row.payment}</td>
                  <td data-label="Current Price">{row.price}</td>
                  <td data-label="Availability">{row.availability}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        {page.priceTableNote && <p class="clean-price-note">{page.priceTableNote}</p>}
      </section>
    )}

    {page.highlights?.length > 0 && (
      <div class="clean-highlights">
        {page.highlights.map((highlight) => (
          <article>
            <span>{highlight.label}</span>
            <strong>{highlight.value}</strong>
          </article>
        ))}
      </div>
    )}

    <aside class="clean-verification-note">
      <strong>Current information:</strong>
      <span>Prices and availability can change. Confirm the exact property, dues, special-location charges and payment instructions before making a material payment.</span>
      <time datetime={page.reviewed}>Reviewed {new Date(`${page.reviewed}T00:00:00Z`).toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" })}</time>
    </aside>

    <div class="clean-sections">
      {page.sections.map((section, index) => (
        <section class="clean-copy" id={slugify(section.heading)}>
          <div class="clean-section-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</div>
          <div>
            <h2>{section.heading}</h2>
            {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </section>
      ))}
    </div>

    {page.downloads && page.downloads.length > 0 && (
      <section class="clean-panel" id="plans-downloads">
        <div class="clean-panel-heading">
          <p class="section-label">Plans & Downloads</p>
          <h2>Open the right plan before you shortlist a plot</h2>
        </div>
        <div class="download-card-grid">
          {page.downloads.map((download) => (
            <article class="download-card">
              <span>{download.label}</span>
              <h3>{download.title}</h3>
              <p>{download.text}</p>
              <a href={download.href} target="_blank" rel="noreferrer">Open PDF</a>
            </article>
          ))}
        </div>
      </section>
    )}

    <section class="clean-panel" id="buyer-checklist">
      <div class="clean-panel-heading">
        <p class="section-label">Buyer Checklist</p>
        <h2>Check these points before you proceed</h2>
      </div>
      <div class="clean-checklist">
        {page.bullets.map((item, index) => (
          <article>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="clean-contact-card" aria-labelledby="clean-contact-heading">
      <div>
        <p class="section-label">Current Availability</p>
        <h2 id="clean-contact-heading">Ask about this exact page on WhatsApp</h2>
        <p>Send your preferred size, budget and the sector or block you are considering. Ask for the exact current options rather than a general list.</p>
      </div>
      <div class="clean-contact-actions">
        <a class="btn primary" data-cta-location="landing-bottom" href={whatsappLink(`${page.primaryCta}: ${page.h1}`)}>{page.primaryCta}</a>
        <a class="btn outline" data-cta-location="landing-bottom-secondary" href={whatsappLink(`${page.secondaryCta}: ${page.h1}`)}>{page.secondaryCta}</a>
      </div>
    </section>

    {page.faqs?.length > 0 && (
      <section class="clean-faq" id="faqs">
        <p class="section-label">Quick Questions</p>
        <h2>Frequently asked questions</h2>
        <div class="faq-list">
          {page.faqs.map((faq) => (
            <details>
              <summary>{faq.question}</summary>
              <p>{faq.answer}</p>
            </details>
          ))}
        </div>
      </section>
    )}

    <section class="clean-related">
      <p class="section-label">Keep Exploring</p>
      <h2>Related pages</h2>
      <div class="related-links">
        {page.links.map((link) => <a href={link.href}>{link.label}</a>)}
        <a href="/">Faisal Town Islamabad Home</a>
      </div>
    </section>
  </article>
</ContentLayout>
