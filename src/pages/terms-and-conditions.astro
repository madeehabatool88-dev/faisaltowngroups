---
import ContentLayout from "../layouts/ContentLayout.astro";
import { site, whatsappLink } from "../data/site";
import page from "../content/legal/terms-and-conditions.json";
---

<ContentLayout
  title={page.title}
  description={page.description}
  eyebrow={page.eyebrow}
  heading={page.heading}
  subheading={page.subheading}
>
  <section class="content-section legal-content">
    <p><strong>Last updated:</strong> {new Date(`${page.updated}T00:00:00Z`).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" })}</p>
    {page.sections.map((section) => (
      <>
        <h2>{section.heading}</h2>
        {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </>
    ))}
    <div class="legal-contact">
      <a class="btn primary" href={whatsappLink(page.ctaQuery)}>{page.ctaLabel}: {site.phoneDisplay}</a>
    </div>
  </section>
</ContentLayout>
