---
import ContentLayout from "../layouts/ContentLayout.astro";
import { whatsappLink } from "../data/site";
import pageData from "../content/legal/disclaimer.json";
import { parseProjectBody } from "../data/projectBulk";
const page = { ...pageData, sections: parseProjectBody(pageData.body) };
---

<ContentLayout
  title={page.title}
  description={page.description}
  eyebrow={page.eyebrow}
  heading={page.heading}
  subheading={page.subheading}
>
  <section class="content-section legal-content">
    <p><strong>Last updated:</strong> {new Date(`${page.updated}T00:00:00Z`).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" })}</p>
    {page.sections.map((section) => (
      <>
        <h2>{section.heading}</h2>
        {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </>
    ))}
    <div class="article-cta">
      <div>
        <span>Need verification help?</span>
        <strong>Ask for current availability and booking guidance before payment.</strong>
      </div>
      <a href={whatsappLink(page.ctaQuery)}>{page.ctaLabel}</a>
    </div>
  </section>
</ContentLayout>
