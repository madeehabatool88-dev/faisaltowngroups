---
import ResponsiveImage from "./ResponsiveImage.astro";
import presentation from "../content/homepage/presentation.json";
import { bulkRows } from "../data/homepageBulk";
import { whatsappLink } from "../data/site";

const { home = false } = Astro.props;
const navItems = bulkRows(presentation.navigationText, ["label", "href"], "Navigation").map(row => [row.label, row.href.startsWith("#") && !home ? `/${row.href}` : row.href]);
---
<header class="site-header" id="siteHeader">
  <a class="brand" href={home ? "#top" : "/"} aria-label="FaisalTown Groups home">
    <ResponsiveImage src="/assets/faisal-town-ii/original-logo.png" sizes="200px" alt="FaisalTown Groups" width="371" height="98" decoding="async" />
  </a>
  <button class="nav-toggle" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="primary-navigation" data-nav-toggle>
    <span></span><span></span><span></span>
  </button>
  <nav class="site-nav" id="primary-navigation" aria-label="Primary navigation" data-nav>
    {navItems.map(([label, href]) => <a href={href}>{label}</a>)}
  </nav>
  <a class="header-cta" data-cta-location="header" href={whatsappLink("Check current Faisal Town property availability based on my budget")}>Check Availability</a>
</header>

<script>
  const toggle = document.querySelector("[data-nav-toggle]");
  const nav = document.querySelector("[data-nav]");
  const header = document.querySelector("#siteHeader");

  const closeNav = () => {
    toggle?.setAttribute("aria-expanded", "false");
    toggle?.setAttribute("aria-label", "Open navigation");
    nav?.classList.remove("is-open");
  };

  toggle?.addEventListener("click", () => {
    const open = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!open));
    toggle.setAttribute("aria-label", open ? "Open navigation" : "Close navigation");
    nav?.classList.toggle("is-open", !open);
  });

  nav?.querySelectorAll("a").forEach((link) => link.addEventListener("click", closeNav));
  document.addEventListener("keydown", (event) => event.key === "Escape" && closeNav());
  document.addEventListener("click", (event) => {
    if (header && event.target instanceof Node && !header.contains(event.target)) closeNav();
  });
  window.addEventListener("scroll", () => header?.classList.toggle("is-scrolled", window.scrollY > 20), { passive: true });
</script>
