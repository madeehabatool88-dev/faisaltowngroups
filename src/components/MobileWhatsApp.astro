---
import ResponsiveImage from "./ResponsiveImage.astro";
import { whatsappLink } from "../data/site";
const { heading = "Faisal Town property", phase = "general", message } = Astro.props;
const query = message || `Please help me with ${heading}. My budget is ___ and preferred plot size is ___. Please confirm current availability, total payable amounts and map locations.`;
const label = phase === "phase_1" ? "Phase 1 Plots" : phase === "phase_2" ? "Phase 2 Plots" : "Property Enquiry";
---
<a class="whatsapp-float" data-cta-location="floating" data-project-phase={phase} data-cta-label={`${heading} WhatsApp enquiry`} href={whatsappLink(query)} aria-label={`Enquire about ${heading} on WhatsApp`}>
  <ResponsiveImage src="/assets/whatsapp-logo-green.webp" alt="" sizes="64px" width="64" height="64" loading="lazy" decoding="async" />
</a>
<div class="mobile-sticky-cta" aria-label="Quick property inquiry">
  <a data-cta-location="mobile-sticky" data-project-phase={phase} data-cta-label={`${heading} prices`} href={whatsappLink(query)}>{label}</a>
  <a data-cta-location="mobile-sticky" data-project-phase={phase} data-cta-label={`${heading} WhatsApp enquiry`} href={whatsappLink(query)}>
    <ResponsiveImage src="/assets/whatsapp-logo-green.webp" alt="" sizes="24px" width="64" height="64" decoding="async" />
    <span>WhatsApp</span>
  </a>
  <a data-cta-location="mobile-sticky" data-project-phase="phase_1" href={whatsappLink("I want current Faisal Town Phase 1 / F-18 availability")}>Phase 1</a>
</div>
