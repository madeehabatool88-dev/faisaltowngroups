---
import Cta from "../HomeCta.astro";
import { bulkRows, bulkSlugs } from "../../data/homepageBulk";
import { imageMeta } from "../../data/imageMeta";

const { hero, featuredStarting, featuredSector, secondaryHref } = Astro.props;

const background = hero.heroBackgroundImage || hero.heroImage;
const backgroundMeta = imageMeta[background] || { width: 1440, height: 810 };
const stats = bulkRows(hero.statsText || "", ["value", "label"], "Hero stats");
const points = bulkSlugs(hero.trustPointsText || "");
---

<section class="hp-hero" id="phase-2" data-home-section="hero">
  {background && (
    <img
      class="hp-hero-bg"
      src={background}
      alt=""
      width={backgroundMeta.width}
      height={backgroundMeta.height}
      loading="eager"
      fetchpriority="high"
      decoding="sync"
      aria-hidden="true"
    />
  )}

  <div class="hp-hero-inner hp-wrap">
    <p class="hp-kicker">{hero.heroEyebrow}</p>

    <h1>{hero.h1}</h1>

    <p class="hp-intro">{hero.intro}</p>

    {featuredStarting && (
      <p class="hp-start">
        <span>
          {hero.startingPriceLabel} · {featuredSector}
        </span>

        <strong>{featuredStarting}</strong>
      </p>
    )}

    <div class="hp-actions">
      <Cta
        label={hero.primaryCta}
        type={hero.primaryCtaType}
        href={hero.primaryHref}
        query={hero.primaryWhatsappQuery}
        section="hero"
      />

      <Cta
        label={hero.secondaryCta}
        type={hero.secondaryCtaType}
        href={secondaryHref}
        query={hero.secondaryWhatsappQuery}
        section="hero"
        secondary
      />
    </div>

    {points.length > 0 && (
      <ul class="hp-points">
        {points.map((point) => (
          <li>
            <span aria-hidden="true">✓</span>
            {point}
          </li>
        ))}
      </ul>
    )}

    {featuredStarting && hero.priceDisclaimer && (
      <p class="hp-hero-disclaimer">{hero.priceDisclaimer}</p>
    )}
  </div>

  {stats.length > 0 && (
    <div class="hp-hero-stats">
      <div class="hp-wrap hp-hero-stats-grid">
        {stats.map((stat) => (
          <div class="hp-stat">
            <strong>{stat.value}</strong>
            <span>{stat.label}</span>
          </div>
        ))}
      </div>
    </div>
  )}

  {(hero.topStripLabel || hero.topStripText) && (
    <p class="hp-hero-strip">
      <span>{hero.topStripLabel}</span>
      {hero.topStripText}
    </p>
  )}
</section>
