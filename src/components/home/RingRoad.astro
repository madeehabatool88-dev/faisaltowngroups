---
import { landingPages } from '../../data/landingPages';
import Cta from '../HomeCta.astro';
import { bulkRows } from '../../data/homepageBulk';
const page = landingPages.find(p => p.slug === 'faisal-town-ring-road-block');
const rows = bulkRows(page?.rateDetailsText || '', ['size', 'dimensions', 'cost', 'registration', 'actual', 'discount'], 'Ring Road rates');
---
{page && <section class="hp-section hp-tint hp-ring-road" id="ring-road-block" data-home-section="ringRoad">
  <div class="hp-wrap hp-ring-road-grid">
    <div>
      <p class="hp-kicker">Phase 2 · Ring Road Block</p>
      <h2>Ring Road Block full-payment plots</h2>
      <p>{page.intro}</p>
      <p class="hp-status">Development charges included in plot cost. Ask for your complete quotation.</p>
      <div class="hp-actions">
        <Cta label="View Ring Road Block & Full Rates" href={`/${page.slug}/`} section="ring_road" />
        <Cta label="Check Ring Road Plots" query={page.rateInquiryQuery} section="ring_road" sector="Ring Road Block" secondary />
      </div>
    </div>
    <div>
      <table class="hp-ring-road-table">
        <caption>Listed discounted prices · Full payment</caption>
        <thead><tr><th scope="col">Plot size</th><th scope="col">Price (PKR)</th></tr></thead>
        <tbody>{rows.map(row => <tr><th scope="row">{row.size}<small>{row.dimensions} ft</small></th><td>{row.discount}</td></tr>)}</tbody>
      </table>
      <p class="hp-ring-road-note">Share your preferred size for available plot numbers and a complete quotation.</p>
    </div>
  </div>
</section>}
