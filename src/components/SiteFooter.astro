---
import { site, whatsappLink } from "../data/site";
---
<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <img src="/assets/faisal-town-ii/original-logo.png" alt="FaisalTown Groups" width="371" height="98" loading="lazy" decoding="async" />
      <p>Independent Faisal Town property information, map guidance and buyer assistance for Phase 1 / F-18 and Phase 2 / FT-II.</p>
      <p class="footer-disclosure"><strong>Independent website:</strong> FaisalTown Groups is not presented as the official developer website. Verify project approvals, booking instructions, ownership and payment details with the relevant official sources before paying.</p>
    </div>
    <div>
      <h3>Buyer Pages</h3>
      <a href="/faisal-town-phase-1/">Faisal Town Phase 1</a>
      <a href="/faisal-town-phase-2/">Faisal Town Phase 2</a>
      <a href="/plots-for-sale-faisal-town-islamabad/">Plots for Sale</a>
      <a href="/faisal-town-islamabad-map-location/">Map & Location</a>
      <a href="/articles/">Guides</a>
    </div>
    <div>
      <h3>Support & Policies</h3>
      <a data-cta-location="footer" href={whatsappLink("I want current Faisal Town availability and prices")}>WhatsApp: {site.phoneDisplay}</a>
      <a data-cta-location="footer" href={whatsappLink("I want help choosing the right Faisal Town property for my budget")}>Start Property Inquiry</a>
      <a href="/all-pages/">All Pages</a>
      <a href="/privacy-policy/">Privacy Policy</a>
      <a href="/disclaimer/">Disclaimer</a>
      <a href="/terms-and-conditions/">Terms</a>
    </div>
  </div>
  <p class="copyright">Copyright 2026 FaisalTown Groups. All rights reserved.</p>
</footer>
